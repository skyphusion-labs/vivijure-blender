# deploy.env -- keys and settings for ./deploy.sh (vivijure-blender, compositor finish).
# Copy to deploy.env and fill in. deploy.env is git-ignored; never commit it.

# ---- required ---------------------------------------------------------------

RUNPOD_API_KEY=

# Image you control (build + push). Change <you> for a fork.
IMAGE=ghcr.io/skyphusion-labs/vivijure-blender:0.1.0

ENDPOINT_NAME=vivijure-blender

# Compositor is light; a small Ada card is enough. Cycles titles later may want more VRAM.
GPU_TYPE_IDS=NVIDIA L4,NVIDIA L40S,NVIDIA RTX PRO 6000 Blackwell Server Edition

# ---- optional ---------------------------------------------------------------

# Blender tarball is ~300MB unpacked; leave headroom for frame dumps.
CONTAINER_DISK_GB=40

# WORKERS_MIN=0
# WORKERS_MAX=2
# IDLE_TIMEOUT=5
# EXECUTION_TIMEOUT_MS=900000

# CONTAINER_REGISTRY_AUTH_ID=
# REGISTRY_USER=
# REGISTRY_TOKEN=

# R2 finish-chain mode (required for studio finish-blender).
# R2_ENDPOINT_URL=
# R2_BUCKET=vivijure
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional pin for presigned-mode hosts. Production sets this; empty skips the suffix check
# (homelab). https + private/link-local/metadata refusal still apply.
# R2_URL_HOST_SUFFIX=.r2.cloudflarestorage.com

# Handler knobs. Sequential; they SUM. Composite at these defaults is 4320s,
# under the 5400s studio phase ceiling (vivijure-blender#17). Do not raise a
# knob until that sum meets 5400 -- the door will refuse the job.
# MAX_FRAMES=600
# DOWNLOAD_TIMEOUT=300
# UPLOAD_TIMEOUT=300
# BLENDER_TIMEOUT=1800
# FFMPEG_TIMEOUT=480

# SKIP_BUILD=0
# SKIP_ENDPOINT=0

STUDIO_ENV_HINT="In vivijure-cf deploy.env set BLENDER_RUNPOD_ENDPOINT_ID to the endpoint id above, bind MODULE_FINISH_BLENDER to vivijure-module-finish-blender, and see docs/opt-in-tiers.md (finish-blender)."
